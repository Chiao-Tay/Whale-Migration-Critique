{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Number of whale species recorded off each state, 2016-2025. Offshore reports are assigned to the nearest state's coast.",
  "width": 760,
  "height": 610,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia-states.json",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name !== 'Macquarie Island' && datum.properties.name !== 'Lord Howe Island' && datum.properties.name !== 'Jervis Bay Territory'"
        },
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "data/c3_species_by_state.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "species_count": "number",
                  "records": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "species_count",
              "records",
              "species_list"
            ]
          }
        },
        {
          "calculate": "isValid(datum.species_count) ? toNumber(datum.species_count) : null",
          "as": "species_count"
        },
        {
          "calculate": "isValid(datum.records) ? toNumber(datum.records) : null",
          "as": "records"
        }
      ],
      "params": [
        {
          "name": "hoverState",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff"
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "!isValid(datum.species_count)",
            "value": "#f1f0ec"
          },
          "field": "species_count",
          "type": "ordinal",
          "title": "Species recorded",
          "scale": {
            "domain": [
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ],
            "range": [
              "#cde2fb",
              "#9ec5f4",
              "#6da7ec",
              "#3987e5",
              "#256abf",
              "#184f95",
              "#0d366b"
            ]
          }
        },
        "strokeWidth": {
          "condition": {
            "param": "hoverState",
            "empty": false,
            "value": 2.5
          },
          "value": 0.8
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "State"
          },
          {
            "field": "species_count",
            "title": "Species recorded"
          },
          {
            "field": "records",
            "title": "Reports",
            "format": ","
          },
          {
            "field": "species_list",
            "title": "Species (most reported first)"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "Western Australia",
            "abbr": "WA",
            "lon": 121.5,
            "lat": -26.5
          },
          {
            "state": "Northern Territory",
            "abbr": "NT",
            "lon": 133.5,
            "lat": -20.5
          },
          {
            "state": "South Australia",
            "abbr": "SA",
            "lon": 135.0,
            "lat": -30.0
          },
          {
            "state": "Queensland",
            "abbr": "QLD",
            "lon": 144.5,
            "lat": -22.5
          },
          {
            "state": "New South Wales",
            "abbr": "NSW",
            "lon": 146.5,
            "lat": -32.3
          }
        ]
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/c3_species_by_state.csv"
            },
            "key": "state",
            "fields": [
              "species_count"
            ]
          }
        },
        {
          "calculate": "toNumber(datum.species_count)",
          "as": "n"
        },
        {
          "calculate": "[datum.abbr, datum.n + ' species']",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "lineHeight": 13,
        "tooltip": false
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "datum.n >= 5",
            "value": "#ffffff"
          },
          "value": "#1d1d1b"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "Tasmania",
            "abbr": "TAS",
            "lon": 150.8,
            "lat": -42.4
          },
          {
            "state": "Victoria",
            "abbr": "VIC",
            "lon": 141.2,
            "lat": -39.8
          }
        ]
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/c3_species_by_state.csv"
            },
            "key": "state",
            "fields": [
              "species_count"
            ]
          }
        },
        {
          "calculate": "[datum.abbr, toNumber(datum.species_count) + ' species']",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 11,
        "fontWeight": 600,
        "lineHeight": 13,
        "fill": "#1d1d1b",
        "tooltip": false
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, system-ui, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "gridColor": "#d3dde8",
      "domainColor": "#b9c6d3",
      "tickColor": "#b9c6d3"
    },
    "legend": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "symbolStrokeWidth": 0
    },
    "header": {
      "labelColor": "#1d1d1b",
      "titleColor": "#52514e",
      "labelFontSize": 12,
      "labelFontWeight": 600
    },
    "title": {
      "color": "#1d1d1b",
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "subtitleColor": "#52514e"
    }
  }
}
