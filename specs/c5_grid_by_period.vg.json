{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Whale reports per 1-degree square, by two-month period, 2016-2025.",
  "vconcat": [
    {
      "hconcat": [
        {
          "title": {
            "text": "January – February · 29 reports",
            "fontSize": 12,
            "fontWeight": 600
          },
          "width": 278,
          "height": 235,
          "projection": {
            "type": "conicEqualArea",
            "parallels": [
              -18,
              -36
            ],
            "rotate": [
              -132,
              0,
              0
            ]
          },
          "layer": [
            {
              "data": {
                "url": "data/australia-states.json",
                "format": {
                  "type": "topojson",
                  "feature": "australia_states"
                }
              },
              "transform": [
                {
                  "filter": "datum.properties.name !== 'Macquarie Island' && datum.properties.name !== 'Lord Howe Island'"
                }
              ],
              "mark": {
                "type": "geoshape",
                "fill": "#e9e7e2",
                "stroke": "#ffffff",
                "strokeWidth": 0.8,
                "tooltip": false
              }
            },
            {
              "data": {
                "url": "data/c5_grid_by_period.csv",
                "format": {
                  "type": "csv",
                  "parse": {
                    "period_order": "number",
                    "lat_bin": "number",
                    "lon_bin": "number",
                    "records": "number"
                  }
                }
              },
              "transform": [
                {
                  "filter": "datum.period === 'Jan-Feb'"
                }
              ],
              "mark": {
                "type": "square",
                "size": 40,
                "opacity": 0.95
              },
              "encoding": {
                "longitude": {
                  "field": "lon_bin",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "lat_bin",
                  "type": "quantitative"
                },
                "color": {
                  "field": "records",
                  "type": "quantitative",
                  "title": "Reports per 1° square",
                  "scale": {
                    "type": "log",
                    "domain": [
                      1,
                      1000
                    ],
                    "clamp": true,
                    "range": [
                      "#9ec5f4",
                      "#0d366b"
                    ]
                  },
                  "legend": {
                    "orient": "bottom",
                    "direction": "horizontal",
                    "gradientLength": 220,
                    "values": [
                      1,
                      10,
                      100,
                      1000
                    ]
                  }
                },
                "tooltip": [
                  {
                    "field": "period",
                    "title": "Months"
                  },
                  {
                    "field": "records",
                    "title": "Reports",
                    "format": ","
                  },
                  {
                    "field": "lat_bin",
                    "title": "Latitude",
                    "format": ".1f"
                  },
                  {
                    "field": "lon_bin",
                    "title": "Longitude",
                    "format": ".1f"
                  }
                ]
              }
            }
          ]
        },
